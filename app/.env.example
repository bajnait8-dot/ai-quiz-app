# Required: get a key from https://console.groq.com/ (Sign up -> API Keys)
GROQ_API_KEY=your_groq_api_key

# Optional overrides
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0

# SQLite file used for quizzes and evaluations
DATABASE_PATH=./data/quiz.db

# Form / LLM limits
TOPIC_MIN_LENGTH=10
TOPIC_MAX_LENGTH=150
QUIZ_MIN_QUESTIONS=5
QUIZ_MAX_QUESTIONS=15
QUIZ_GENERATION_ATTEMPTS=2

# Abuse protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
ENVIRONMENT=development
LOG_LEVEL=INFO
